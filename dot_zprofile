#
# Managed by chezmoi (github.com/gavinzhou/dotfiles). Edit there, not here.
#
# Login shells run /etc/zprofile (path_helper) after ~/.zshenv, which moves
# system directories to the front of PATH. Put back the order ~/.zshenv set;
# anything path_helper added goes after it, then gets sorted the same way.
#
if [[ -n ${_dotfiles_saved_path:-} ]]; then
  typeset -U path
  path=(${(s.:.)_dotfiles_saved_path} $path)
  (( $+functions[_dotfiles_path] )) && _dotfiles_path
fi
