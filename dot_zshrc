#
# Managed by chezmoi (github.com/gavinzhou/dotfiles). Edit there, not here:
# `chezmoi edit ~/.zshrc`, then `chezmoi apply`.
#

# AI agent CLIs (Claude Code, Codex, ...) source this file to snapshot the
# environment. They need PATH and env vars, but not prompts, aliases or
# output-producing commands. Set AGENT_SHELL=1 to force agent mode elsewhere.
if [[ -n "$CLAUDECODE" || -n "$CODEX_SANDBOX" || -n "$CODEX_THREAD_ID" || -n "$AGENT_SHELL" ]]; then
  _agent_shell=1
fi

#
# Environment (shared by humans and agents)
#

export EDITOR=vim

export GOPATH=${HOME}/go
export GO111MODULE=on
export GOBIN=${HOME}/go/bin

export BUN_INSTALL="$HOME/.bun"
export MISE_GLOBAL_CONFIG_FILE="$HOME/.mise.toml"
export USE_GKE_GCLOUD_AUTH_PLUGIN=True
export PKG_CONFIG_PATH="/opt/homebrew/opt/jpeg/lib/pkgconfig"
export JAVA_HOME="/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home"
export ANDROID_HOME="$HOME/Library/Android/sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"

# PATH: earlier entries win, duplicates are dropped, and (N-/) keeps only
# directories that exist, so stale tool paths do nothing. mise shims come
# early so agents get the same node/python/terraform as interactive shells.
typeset -U path
path=(
  $HOME/.local/bin(N-/)
  $HOME/.local/share/mise/shims(N-/)
  $HOME/bin(N-/)
  $BUN_INSTALL/bin(N-/)
  /opt/homebrew/opt/openjdk@25/bin(N-/)
  $ANDROID_HOME/platform-tools(N-/)
  $ANDROID_HOME/emulator(N-/)
  $ANDROID_HOME/cmdline-tools/latest/bin(N-/)
  $HOME/.daml/bin(N-/)
  /opt/homebrew/opt/openvpn/sbin(N-/)
  /opt/homebrew/opt/libpq/bin(N-/)
  $HOME/.gloo/bin(N-/)
  $GOBIN(N-/)
  /opt/homebrew/bin(N-/)
  /opt/homebrew/sbin(N-/)
  /usr/local/bin
  /usr/bin
  /bin
  /usr/sbin
  /sbin
  $HOME/.krew/bin(N-/)
  $HOME/.platformio/penv/bin(N-/)
  /Applications/Keybase.app/Contents/SharedSupport/bin(N-/)
)
export PATH

# Google Cloud SDK
_gcloud_sdk=/opt/homebrew/share/google-cloud-sdk
[[ -f $_gcloud_sdk/path.zsh.inc ]] && source $_gcloud_sdk/path.zsh.inc

# Secrets and machine-specific settings live outside this public repo:
# ~/.secrets.zsh (chmod 600) for tokens, ~/.zshrc.local for everything else.
[[ -r ~/.secrets.zsh ]] && source ~/.secrets.zsh
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local

#
# Interactive only (skipped for agents)
#

if [[ -n "$_agent_shell" ]]; then
  unset _agent_shell _gcloud_sdk
  return
fi

# History
HISTFILE=~/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# Editing and navigation
bindkey -e
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS INTERACTIVE_COMMENTS
bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward

# Completion
autoload -Uz compinit && compinit -i
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# Prompt: directory, git branch, and a red % after a failed command
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats ' %F{magenta}%b%f'
setopt PROMPT_SUBST
PROMPT='%F{blue}%~%f${vcs_info_msg_0_} %(?.%#.%F{red}%#%f) '

# mise switches tool versions per directory
(( $+commands[mise] )) && eval "$(mise activate zsh)"

# Aliases
alias k=kubectl
alias kc=kubectx
alias kn=kubens
alias ccv="circleci config validate"
alias vpn="sudo openvpn --config ${HOME}/.gavin.ovpn"
alias allvpn="sudo openvpn --config ${HOME}/.gavin.ovpn --redirect-gateway def1"
alias vault="cd \"$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Gavin\""

# gpg / ssh
export GPG_TTY=$(tty)
ssh-add -q 2>/dev/null

# Completions
[[ -f $_gcloud_sdk/completion.zsh.inc ]] && source $_gcloud_sdk/completion.zsh.inc
(( $+commands[kubectl] )) && source <(kubectl completion zsh)
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
[ -f "$HOME/.openclaw/completions/openclaw.zsh" ] && source "$HOME/.openclaw/completions/openclaw.zsh"

unset _agent_shell _gcloud_sdk
