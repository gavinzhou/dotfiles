#
# Managed by chezmoi (github.com/gavinzhou/dotfiles). Edit there, not here:
# `chezmoi edit ~/.zshrc`, then `chezmoi apply`.
#
# Interactive setup only. Environment variables and PATH are in ~/.zshenv,
# which every zsh reads first.
#

# Some agent CLIs source this file to snapshot the environment. They already
# have everything from ~/.zshenv and need none of the prompt or aliases below.
[[ ${AGENT_SHELL:-} == 1 ]] && return

# History
HISTFILE=~/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# Editing and navigation
bindkey -e
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS INTERACTIVE_COMMENTS
bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward

# Completion
autoload -Uz compinit && compinit -i
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

#
# Prompt
#   [host] ~/dir main* aws:dev k8s:ctx %          took 12s
# host only over SSH; * unstaged, + staged; aws/k8s only when set, red when
# the name contains "prod"; red % after a failed command; duration on the
# right after commands that ran 10s or more.
#
autoload -Uz vcs_info add-zsh-hook
zmodload zsh/datetime
setopt PROMPT_SUBST

zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' unstagedstr '*'
zstyle ':vcs_info:git:*' stagedstr '+'
zstyle ':vcs_info:git:*' formats ' %F{magenta}%b%u%c%f'
zstyle ':vcs_info:git:*' actionformats ' %F{magenta}%b|%a%u%c%f'

# Name in red when it looks like production, yellow otherwise. Control
# characters are dropped and % is escaped, so a name cannot change the prompt.
_prompt_env() {
  local label=$1 name=${2//[[:cntrl:]]/}
  name=${name//\%/%%}
  [[ -z $name ]] && return
  if [[ $name == *prod* ]]; then
    print -rn -- " %F{red}${label}:${name}%f"
  else
    print -rn -- " %F{yellow}${label}:${name}%f"
  fi
}

# Current kubectl context. kubectl merges every file in KUBECONFIG, so ask it,
# but only again after one of those files changes. Runs in the prompt's own
# shell (not a subshell) so the cache survives between prompts.
zmodload -F zsh/stat b:zstat
_prompt_kube_key='' _prompt_kube_ctx=''
_prompt_kube_refresh() {
  if (( ! $+commands[kubectl] )); then
    _prompt_kube_ctx=''
    return
  fi
  local f key='' m
  for f in ${(s.:.)${KUBECONFIG:-$HOME/.kube/config}}; do
    [[ -r $f ]] || continue
    zstat -A m +mtime -- "$f" 2>/dev/null || continue
    key+="$f:$m;"
    # mtime has 1s resolution: a file changed within the last 2s may change
    # again in the same second, so do not trust the cache yet
    (( EPOCHSECONDS - m < 2 )) && key+="recent:$EPOCHREALTIME;"
  done
  if [[ $key != $_prompt_kube_key ]]; then
    _prompt_kube_key=$key
    _prompt_kube_ctx=''
    [[ -n $key ]] && _prompt_kube_ctx=$(kubectl config current-context 2>/dev/null)
  fi
}

_prompt_cmd_start=0
_prompt_cmd=''
_prompt_preexec() { _prompt_cmd_start=$EPOCHREALTIME; _prompt_cmd=$1 }
_prompt_precmd() {
  vcs_info
  _prompt_kube_refresh
  _prompt_envs="$(_prompt_env aws "${AWS_PROFILE:-${AWS_VAULT:-}}")$(_prompt_env k8s "$_prompt_kube_ctx")"

  RPROMPT=''
  if (( _prompt_cmd_start > 0 )); then
    local took=$(( EPOCHREALTIME - _prompt_cmd_start ))
    _prompt_cmd_start=0
    if (( took >= 10 )); then
      local secs=${took%.*}
      if (( secs >= 60 )); then
        RPROMPT="%F{242}took $((secs / 60))m$((secs % 60))s%f"
        # Desktop notification from Ghostty (shown when the window is not focused)
        printf '\e]9;%s\a' "Done after $((secs / 60))m$((secs % 60))s: ${_prompt_cmd:0:60}"
      else
        RPROMPT="%F{242}took ${secs}s%f"
      fi
    fi
  fi
}
add-zsh-hook preexec _prompt_preexec
add-zsh-hook precmd _prompt_precmd

_prompt_host=''
[[ -n $SSH_CONNECTION ]] && _prompt_host='%F{cyan}%m%f '
PROMPT='${_prompt_host}%F{blue}%~%f${vcs_info_msg_0_}${_prompt_envs} %(?.%#.%F{red}%#%f) '

# mise switches tool versions per directory
(( $+commands[mise] )) && eval "$(mise activate zsh)"

# Aliases
alias k=kubectl
alias kc=kubectx
alias kn=kubens
alias ccv="circleci config validate"
alias vpn="sudo openvpn --config ${HOME}/.gavin.ovpn"
alias allvpn="sudo openvpn --config ${HOME}/.gavin.ovpn --redirect-gateway def1"
alias vault="cd \"$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Gavin\""

# gpg / ssh
export GPG_TTY=$(tty)
ssh-add -q 2>/dev/null

# Interactive-only local settings (not in this public repo)
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local

# Completions
[[ -f /opt/homebrew/share/google-cloud-sdk/completion.zsh.inc ]] && source /opt/homebrew/share/google-cloud-sdk/completion.zsh.inc
(( $+commands[kubectl] )) && source <(kubectl completion zsh)
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
[ -f "$HOME/.openclaw/completions/openclaw.zsh" ] && source "$HOME/.openclaw/completions/openclaw.zsh"
