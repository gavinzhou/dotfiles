// Zed settings (managed by chezmoi: edit dot_config/zed/private_settings.json in the dotfiles repo).
// Tokyo Night theme, JetBrains Mono (same font as Rex).
{
  "auto_install_extensions": {
    "tokyo-night": true
  },
  "vim_mode": false,
  "ui_font_size": 16,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 15,
  "terminal": {
    "font_family": "JetBrains Mono"
  },
  "theme": {
    "mode": "dark",
    "light": "Tokyo Night Light",
    "dark": "Tokyo Night"
  }
}
