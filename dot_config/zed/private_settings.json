// Zed settings (managed by chezmoi: edit dot_config/zed/private_settings.json in the dotfiles repo).
// Match Rex: Solarized Dark, JetBrains Mono.
{
  "auto_install_extensions": {
    "solarized": true
  },
  "vim_mode": false,
  "ui_font_size": 16,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 15,
  "terminal": {
    "font_family": "JetBrains Mono"
  },
  "theme": {
    "mode": "dark",
    "light": "Solarized Light",
    "dark": "Solarized Dark"
  }
}
