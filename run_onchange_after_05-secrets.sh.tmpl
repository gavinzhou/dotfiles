#!/bin/bash
# Writes ~/.secrets.zsh from 1Password. Runs only when secrets.zsh.tpl changes,
# so daily syncs never ask for Touch ID.
# secrets.zsh.tpl sha256: {{ include "secrets.zsh.tpl" | sha256sum }}
set -euo pipefail

# Write next to the target and rename, so a failed inject keeps the old file.
umask 077
out="$HOME/.secrets.zsh"
trap 'rm -f "$out.new"' EXIT
/opt/homebrew/bin/op inject -f -i {{ joinPath .chezmoi.sourceDir "secrets.zsh.tpl" | quote }} -o "$out.new"
chmod 600 "$out.new"
mv -f "$out.new" "$out"
