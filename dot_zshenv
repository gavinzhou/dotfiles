#
# Managed by chezmoi (github.com/gavinzhou/dotfiles). Edit there, not here.
#
# Every zsh reads this file: interactive terminals, `zsh -c` and `zsh -lc`
# (which is how Codex and other agents run commands). It must print nothing.
# Interactive-only setup lives in ~/.zshrc.
#

# AI agent CLIs (Claude Code, Codex, ...). Set AGENT_SHELL=1 to force agent
# mode elsewhere, AGENT_SHELL=0 to turn it off.
if [[ ${AGENT_SHELL:-} != 0 ]] && [[ -n ${CLAUDECODE:-} || -n ${CODEX_SANDBOX:-} || -n ${CODEX_THREAD_ID:-} || -n ${AGENT_SHELL:-} ]]; then
  export AGENT_SHELL=1
fi

export LANG=${LANG:-en_US.UTF-8}
export EDITOR=vim

export GOPATH=${HOME}/go
export GO111MODULE=on
export GOBIN=${HOME}/go/bin

export BUN_INSTALL="$HOME/.bun"
export MISE_GLOBAL_CONFIG_FILE="$HOME/.mise.toml"
export PKG_CONFIG_PATH="/opt/homebrew/opt/jpeg/lib/pkgconfig"
export JAVA_HOME="/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home"
export ANDROID_HOME="$HOME/Library/Android/sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"

# The daily dotfiles-sync job runs `brew update`, so commands never stall on it.
export HOMEBREW_NO_AUTO_UPDATE=1

# PATH: our directories in a fixed order, so agents get the same
# node/python/terraform (mise shims) as interactive shells. (N-/) keeps only
# directories that exist. Other directories keep their place relative to
# ours: those the caller put in front (a virtualenv, a project's
# node_modules/.bin, mise's per-project installs) stay in front, the rest
# follow ours, and macOS internals and missing directories go last. Running
# it again changes nothing.
_dotfiles_path() {
  local -a managed front back system
  local d seen=0
  managed=(
    $HOME/.local/bin(N-/)
    $HOME/.local/share/mise/shims(N-/)
    $HOME/bin(N-/)
    $BUN_INSTALL/bin(N-/)
    /opt/homebrew/opt/openjdk@25/bin(N-/)
    $ANDROID_HOME/platform-tools(N-/)
    $ANDROID_HOME/emulator(N-/)
    $ANDROID_HOME/cmdline-tools/latest/bin(N-/)
    $HOME/.daml/bin(N-/)
    /opt/homebrew/opt/openvpn/sbin(N-/)
    /opt/homebrew/opt/libpq/bin(N-/)
    $HOME/.gloo/bin(N-/)
    $GOBIN(N-/)
    /opt/homebrew/share/google-cloud-sdk/bin(N-/)
    /opt/homebrew/bin(N-/)
    /opt/homebrew/sbin(N-/)
    /usr/local/bin
    /usr/bin
    /bin
    /usr/sbin
    /sbin
    $HOME/.platformio/penv/bin(N-/)
    /Applications/Keybase.app/Contents/SharedSupport/bin(N-/)
  )
  for d in $path; do
    if (( ${managed[(Ie)$d]} )); then
      seen=1
    elif [[ ! -d $d || $d == /System/* || $d == /var/run/com.apple.* || $d == /Library/Apple/* ]]; then
      system+=("$d")
    elif (( seen )); then
      back+=("$d")
    else
      front+=("$d")
    fi
  done
  typeset -gU path
  path=($front $managed $back $system)
  export PATH
}
_dotfiles_path

# Agents read command output as text: no pagers, no color codes, and an
# editor that fails at once instead of waiting for a person (use -m or
# --no-edit instead). The values these replace are saved in DOTFILES_ORIG_*
# so a shell started with AGENT_SHELL=0 inside an agent gets them back.
# Runs before the local files below, so values set there always win.
_dotfiles_agent_vars=(PAGER GIT_PAGER GH_PAGER GIT_EDITOR NO_COLOR)
if [[ ${AGENT_SHELL:-} == 1 ]]; then
  if [[ -z ${DOTFILES_AGENT_VARS:-} ]]; then
    for _v in $_dotfiles_agent_vars; do
      (( ${+parameters[$_v]} )) && export "DOTFILES_ORIG_$_v=${(P)_v}"
    done
  fi
  export PAGER=cat GIT_PAGER=cat GH_PAGER=cat
  export GIT_EDITOR=false
  export NO_COLOR=1
  export DOTFILES_AGENT_VARS=1
elif [[ -n ${DOTFILES_AGENT_VARS:-} ]]; then
  # Leaving agent mode: restore saved values, otherwise drop the agent ones
  typeset -A _agent_val=(PAGER cat GIT_PAGER cat GH_PAGER cat GIT_EDITOR false NO_COLOR 1)
  for _v in $_dotfiles_agent_vars; do
    if (( ${+parameters[DOTFILES_ORIG_$_v]} )); then
      [[ ${(P)_v:-} == $_agent_val[$_v] ]] && export "$_v=${(P)${:-DOTFILES_ORIG_$_v}}"
      unset "DOTFILES_ORIG_$_v"
    elif [[ ${(P)_v:-} == $_agent_val[$_v] ]]; then
      unset "$_v"
    fi
  done
  unset DOTFILES_AGENT_VARS _agent_val
fi
unset _v _dotfiles_agent_vars

# Secrets and machine-specific variables live outside this public repo:
# ~/.secrets.zsh (chmod 600, generated from 1Password) and ~/.zshenv.local.
# Both must only assign variables: every zsh, every script, reads them.
[[ -r ~/.secrets.zsh ]] && source ~/.secrets.zsh
[[ -r ~/.zshenv.local ]] && source ~/.zshenv.local

# Login shells: /etc/zprofile (path_helper) runs after this file and moves
# system directories to the front. ~/.zprofile puts this order back.
_dotfiles_saved_path=$PATH
