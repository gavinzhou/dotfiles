#!/bin/bash
# Merges claude-settings.json (shared, public) into ~/.claude/settings.json.
# Keys not in it stay local: autoMode (names internal repos) and whatever
# Claude Code adds. permissions.allow keeps local entries and adds missing ones.
# When the merge changes nothing the file passes through byte for byte, so
# chezmoi (and dotfiles-sync) see no local edit.
set -euo pipefail

# A new Mac may not have Homebrew on PATH yet (appended, so tests can stub op).
export PATH="$PATH:/opt/homebrew/bin"

cur=$(cat; printf x)
cur=${cur%x}
base={{ joinPath .chezmoi.sourceDir "claude-settings.json" | quote }}

cur_json=$cur
[[ $cur == *[![:space:]]* ]] || cur_json='{}'

# Each side must be exactly one JSON object; anything else stops the apply.
merged=$(jq -n --slurpfile cs <(printf '%s' "$cur_json") --slurpfile bs "$base" '
  if ($cs | length) != 1 or ($bs | length) != 1
    or ($cs[0] | type) != "object" or ($bs[0] | type) != "object"
  then error("settings.json and claude-settings.json must each be one JSON object") end
  | $cs[0] as $c | $bs[0] as $b
  | ($c * $b)
  | .permissions.allow = (
      reduce (($c.permissions.allow // []) + ($b.permissions.allow // []))[] as $x
        ([]; if any(.[]; . == $x) then . else . + [$x] end))
')

if [[ $cur == *[![:space:]]* ]] && [[ $(printf '%s' "$merged" | jq -S .) == "$(printf '%s' "$cur" | jq -S .)" ]]; then
  printf '%s' "$cur"
else
  printf '%s' "$merged" | jq .
fi
